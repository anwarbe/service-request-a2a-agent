# Vertex AI Configuration (Recommended for Cloud Run & GCP Partner Engineering)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-partner-eng-gcp-project
GOOGLE_CLOUD_LOCATION=global

# Alternative: Google AI Studio API Key (for local testing without GCP ADC)
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=your-gemini-api-key

# Model & Storage Configuration
GEMINI_MODEL=gemini-3.5-flash
GCS_BUCKET_NAME=oracle-hackathon-servicenow-tickets

# Server & A2A Configuration
PORT=8080
CLOUD_RUN_URL=http://localhost:8080

# Optional Inbound Security (leave empty for unauthenticated hackathon access)
# If set, requests to the A2A JSON-RPC endpoint must include either:
#   X-API-KEY: <A2A_API_KEY>
#   Authorization: Bearer <A2A_API_KEY>
A2A_API_KEY=
